{
  "name": "nexus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && eslint scripts",
    "test": "turbo run test && vitest run --config vitest.scripts.config.mjs && pnpm test:wall",
    "test:wall": "node --test \"supabase/tests/static/*.test.mjs\"",
    "test:live": "node --test \"supabase/tests/live/*.test.mjs\"",
    "check:colours": "node scripts/check-colours.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:strings": "node scripts/check-string-capture.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:css": "node scripts/check-css.mjs",
  "check:egress": "node scripts/check-egress.mjs",
  "check:rls": "node supabase/scripts/check-rls-wall.mjs",
  "db:reset": "supabase db reset",
  "db:test": "supabase db reset && supabase test db"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "turbo": "^2.10.8",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.6"
  }
}
