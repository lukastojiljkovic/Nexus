{
  "name": "nexus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && eslint scripts",
    "test": "turbo run test && vitest run --config vitest.scripts.config.mjs",
    "check:colours": "node scripts/check-colours.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "turbo": "^2.10.8",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.6"
  }
}
