# collection: kresnik-books   kind: book   (Slovenia)
# Objective criterion: P50 "author" -> a person awarded the Kresnik Award
# (Q6436808), Slovenian novel of the year. Wikidata records the award on the
# author, so the collection is "works by Kresnik Award winners".
SELECT ?item ?en ?sr (MIN(?y) AS ?year) (GROUP_CONCAT(DISTINCT ?cr; separator="; ") AS ?creators) WHERE {
  ?item wdt:P50 ?author ;
        wdt:P31/wdt:P279* wd:Q7725634 .
  ?author wdt:P166 wd:Q6436808 .
  OPTIONAL { ?item rdfs:label ?en . FILTER(lang(?en) = "en") }
  OPTIONAL { ?item rdfs:label ?sr . FILTER(lang(?sr) = "sr") }
  OPTIONAL { ?item wdt:P577 ?d . BIND(YEAR(?d) AS ?y) }
  OPTIONAL { ?item wdt:P50 ?a . ?a rdfs:label ?cr . FILTER(lang(?cr) = "en") }
}
GROUP BY ?item ?en ?sr
ORDER BY ?year ?item
