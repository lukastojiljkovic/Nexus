# collection: golden-globe-drama-series   kind: series
# Objective criterion: P166 -> Golden Globe Award for Best Television Series - Drama (Q1255198).
SELECT ?item ?en ?sr (MIN(?y) AS ?year) (GROUP_CONCAT(DISTINCT ?cr; separator="; ") AS ?creators) WHERE {
  ?item wdt:P166 wd:Q1255198 ;
        wdt:P31/wdt:P279* wd:Q5398426 .
  OPTIONAL { ?item rdfs:label ?en . FILTER(lang(?en) = "en") }
  OPTIONAL { ?item rdfs:label ?sr . FILTER(lang(?sr) = "sr") }
  OPTIONAL { ?item wdt:P577 ?d1 . BIND(YEAR(?d1) AS ?y1) }
  OPTIONAL { ?item wdt:P580 ?d2 . BIND(YEAR(?d2) AS ?y2) }
  OPTIONAL { ?item wdt:P170 ?a . ?a rdfs:label ?cr . FILTER(lang(?cr) = "en") }
  BIND(COALESCE(?y1, ?y2) AS ?y)
}
GROUP BY ?item ?en ?sr
ORDER BY ?year ?item
