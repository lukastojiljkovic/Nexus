    {
     "en": "d",
     "sr": "the 'd' in \"dog\""
    },
    {
     "en": "đ",
     "sr": "the 'd(u)' in \"endure\"; rarely used at the beginning of a word; this letter is sometimes written as dj; [the Cyrillic equivalent of this letter is \"ђ\"]"
    },
    {
     "en": "dž",
     "sr": "the 'dge' in \"edge\", but harder [the Cyrillic equivalent of this letter is \"џ\"]; seldom used"
    },
    {
     "en": "f",
     "sr": "the 'f' in \"face\""
    },
    {
     "en": "g",
     "sr": "the 'g' in \"gone\" [always hard 'g']"
    },
    {
     "en": "h",
     "sr": "the 'h' in \"ham\" [quite weak, unlike other Slavonic languages and often dropped, eg \"hoću\" (I will or I wish) becomes <nowiki/>'oću in speech]"
    },
    {
     "en": "j",
     "sr": "the 'y' in \"yes\""
    },
    {
     "en": "k",
     "sr": "the 'k' in \"kick\""
    },
    {
