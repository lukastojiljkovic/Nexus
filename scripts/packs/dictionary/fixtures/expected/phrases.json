   "phrases": [
    {
     "en": "b",
     "sr": "the 'b' in \"abuse\""
    },
    {
     "en": "c",
     "sr": "always as 'ts' in \"bits\""
    },
    {
     "en": "č",
     "sr": "the 'ch' in \"chair\""
