  {
   "id": "basics",
   "title": "Basics",
   "phrases": [
    {
     "en": "Hello.",
     "sr": "Здраво. Zdravo. (ZDRAH-voh)"
    },
    {
     "en": "How are you?",
     "sr": "Како сте? Kako ste? (KAH-koh steh?)"
    },
    {
     "en": "Well, thanks.",
     "sr": "Добро, хвала. Dobro, hvala. (DOH-broh, HVAH-lah)"
    },
    {
     "en": "What is your name?",
     "sr": "Како се зовете? Kako se zovete? (KAH-koh seh ZOH-veh-teh)"
    },
    {
     "en": "My name is ______ .",
     "sr": "Зовем се_____. Zovem se_____. (ZOH-vehm seh_____.)"
    },
    {
     "en": "Pleased to meet you.",
     "sr": "Драго ми је. Drago mi je. (DRAH-goh mee yeh)"
    },
    {
     "en": "Please.",
     "sr": "Молим. Molim. (MOH-leem)"
    },
    {
     "en": "Thank you.",
     "sr": "Хвала. Hvala. (HVAH-lah)"
    },
    {
     "en": "You're welcome.",
     "sr": "Молим. Molim. (MOH-leem)"
    },
    {
     "en": "Yes.",
     "sr": "Да. Da. (DAH)"
    },
    {
     "en": "No.",
     "sr": "Не. Ne. (NEH)"
    },
    {
     "en": "Excuse me. (getting attention)",
     "sr": "Извините. Izvinite. (eez-VEE-nee-teh)"
    },
    {
     "en": "Excuse me. (begging pardon)",
     "sr": "Извините. Izvinite. (eez-VEE-nee-teh)"
    },
    {
     "en": "I'm sorry. (if it isn't speaker's fault, e.g. if you hear bad news)",
     "sr": "Жао ми је. Žao mi je. (ZHOW mee yeh)"
    },
    {
     "en": "I'm sorry. (if it's speaker's fault, e.g. if you bump into someone)",
     "sr": "Извините. Izvinite. (eez-VEE-nee-teh)"
    },
    {
     "en": "Goodbye",
     "sr": "Довиђења. Doviđenja. (doh vee-JEH-nyah)"
    },
    {
     "en": "I can't speak Serbian.",
     "sr": "Не говорим српски. Ne govorim srpski. (neh GOH-voh-reem SR-ps-kee)"
    },
    {
     "en": "Do you speak English?",
     "sr": "Говорите ли енглески? Govorite li engleski? (GOH-voh-ree-teh lee ENH-glehs-kee?)"
    },
    {
     "en": "Is there someone here who speaks English?",
     "sr": "Има ли неког ко говори енглески? Ima li nekog ko govori engleski? (EE-mah lee NEH-kohg koh GOH-voh-ree EHN-glehs-kee ?)"
    },
    {
     "en": "Help!",
     "sr": "Упомоћ! Upomoć! (OO-poh-mohtch!)"
    },
    {
     "en": "Look out!",
     "sr": "Пази! Pazi! (PAH-zee!)"
    }
   ]
  }
 ]
