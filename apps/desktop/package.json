{
  "name": "@nexus/desktop",
  "version": "1.2.0",
  "private": true,
  "description": "Nexus desktop shell — Electron main/preload/renderer with the real SQLite database in the main process behind a typed, allowlisted IPC bridge (ADR-001, SEC-EL).",
  "main": "./out/main/index.js",
  "desktopName": "rs.stojiljkovic.nexus.desktop",
  "author": {
    "name": "Luka Stojiljkovic"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "node scripts/ensure-electron.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "electron-vite build && node scripts/launch.mjs --smoke",
    "shots": "electron-vite build && node scripts/launch.mjs --shots",
    "demo": "electron-vite build && node scripts/launch.mjs --demo",
    "licences": "node scripts/generate-licences.mjs",
    "dist": "node scripts/dist.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@nexus/core": "workspace:*",
    "@nexus/db": "workspace:*",
    "@nexus/sync": "workspace:*",
    "@nexus/sync-crypto": "workspace:*",
    "@nexus/sync-engine": "workspace:*",
    "@nexus/sync-port": "workspace:*",
    "@nexus/sync-transport": "workspace:*",
    "@nexus/tokens": "workspace:*",
    "@nexus/ui": "workspace:*",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-collaboration": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "@tiptap/y-tiptap": "^3.0.9",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "electron-updater": "^6.8.9",
    "katex": "^0.18.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
