{
  "name": "@nexus/desktop",
  "version": "1.5.0",
  "private": true,
  "description": "Nexus desktop shell — Electron main/preload/renderer with the real SQLite database in the main process behind a typed, allowlisted IPC bridge (ADR-001, SEC-EL).",
  "main": "./out/main/index.js",
  "desktopName": "rs.stojiljkovic.nexus.desktop",
  "author": {
    "name": "Luka Stojiljkovic"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "node scripts/ensure-electron.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "node scripts/launch.mjs --smoke",
    "shots": "node scripts/launch.mjs --shots",
    "shots:compare": "node scripts/shots-compare.mjs",
    "demo": "node scripts/launch.mjs --demo",
    "licences": "node scripts/generate-licences.mjs",
    "dist": "node scripts/dist.mjs"
  },
  "dependencies": {
    "@browsermt/bergamot-translator": "^0.4.9",
    "@excalidraw/excalidraw": "^0.18.1",
    "@huggingface/transformers": "^4.3.1",
    "@nexus/core": "workspace:*",
    "@nexus/db": "workspace:*",
    "@nexus/sync": "workspace:*",
    "@nexus/sync-crypto": "workspace:*",
    "@nexus/sync-engine": "workspace:*",
    "@nexus/sync-port": "workspace:*",
    "@nexus/sync-transport": "workspace:*",
    "@nexus/tokens": "workspace:*",
    "@nexus/ui": "workspace:*",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-collaboration": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "@tiptap/y-tiptap": "^3.0.9",
    "@zxing/library": "^0.23.0",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "dxf-viewer": "^1.0.49",
    "gerber-to-svg": "^4.2.8",
    "katex": "^0.19.0",
    "maplibre-gl": "^6.13.0",
    "music-metadata": "^12.1.0",
    "node-llama-cpp": "^3.22.1",
    "pdf-lib": "^1.17.1",
    "pmtiles": "^4.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.186.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "pngjs": "7.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  }
}
