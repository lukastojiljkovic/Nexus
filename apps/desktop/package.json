{
  "name": "@nexus/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Nexus desktop shell — Electron main/preload/renderer with the real SQLite database in the main process behind a typed, allowlisted IPC bridge (ADR-001, SEC-EL).",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/rebuild-native.mjs electron && electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "node scripts/ensure-electron.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "electron-vite build && node scripts/launch.mjs --smoke",
    "licences": "node scripts/generate-licences.mjs",
    "rebuild:electron": "node scripts/rebuild-native.mjs electron",
    "rebuild:node": "node scripts/rebuild-native.mjs node",
    "dist": "node scripts/dist.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@nexus/core": "workspace:*",
    "@nexus/db": "workspace:*",
    "@nexus/tokens": "workspace:*",
    "@nexus/ui": "workspace:*",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-collaboration": "^3.29.2",
    "@tiptap/extension-list": "^3.29.2",
    "@tiptap/extensions": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/suggestion": "^3.29.2",
    "@tiptap/y-tiptap": "^3.0.7",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "electron-updater": "^6.8.9",
    "katex": "^0.18.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^42.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.6"
  }
}
