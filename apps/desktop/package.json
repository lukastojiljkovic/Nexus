{
  "name": "@nexus/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Nexus desktop shell — Electron main/preload/renderer with the real SQLite database in the main process behind a typed, allowlisted IPC bridge (ADR-001, SEC-EL).",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/rebuild-native.mjs electron && electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "node scripts/ensure-electron.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "smoke": "electron-vite build && node scripts/launch.mjs --smoke",
    "rebuild:electron": "node scripts/rebuild-native.mjs electron",
    "rebuild:node": "node scripts/rebuild-native.mjs node",
    "dist": "node scripts/dist.mjs"
  },
  "dependencies": {
    "@nexus/core": "workspace:*",
    "@nexus/db": "workspace:*",
    "@nexus/tokens": "workspace:*",
    "@nexus/ui": "workspace:*",
    "@tiptap/core": "^3.27.3",
    "@tiptap/extension-collaboration": "^3.27.3",
    "@tiptap/extension-list": "^3.27.3",
    "@tiptap/extensions": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "@tiptap/suggestion": "^3.27.3",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "electron-updater": "^6.8.9",
    "katex": "^0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yazl": "^3.3.1",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^42.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  }
}
