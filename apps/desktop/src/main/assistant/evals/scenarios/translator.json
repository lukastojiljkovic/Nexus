        { "role": "user", "content": "Kako se na engleskom kaže „zdravo“?" }
      ],
      "tools": [
        {
          "name": "translator.lookup",
          "effect": "read",
          "content": "Rečnik sr-en (1):\n- zdravo [interjection]: hello, hi (https://en.wiktionary.org/wiki/zdravo)"
        }
      ],
      "knowledge": [],
      "confirmations": [],
      "maxSteps": 2,
      "expect": {
        "toolsCalled": [
          { "name": "translator.lookup", "args": { "word": { "eq": "zdravo" } } }
        ],
        "answerContains": ["hello"],
        "language": "sr",
        "maxSteps": 2
      },
      "script": [
        {
          "toolCalls": [
            { "name": "translator.lookup", "arguments": { "word": "zdravo" } }
