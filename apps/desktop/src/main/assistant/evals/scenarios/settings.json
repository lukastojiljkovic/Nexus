        }
      ]
    },
    {
      "id": "settings-appearance-write-en",
      "title": "Switching to the night theme",
      "locale": "en",
      "conversation": [
        { "role": "user", "content": "Switch to the night theme, please." }
      ],
      "tools": [
        {
          "name": "settings.preference",
          "effect": "write",
          "summary": { "sr": "Promeni temu na „noc“", "en": "Change the theme to “noc”" },
          "content": "Change: the theme is “noc” on the Settings page."
        }
      ],
      "knowledge": [],
      "confirmations": [true],
      "maxSteps": 2,
      "expect": {
