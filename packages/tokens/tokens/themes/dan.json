    "zad":     { "accent": "{color.jade.600}",    "accentSoft": "{color.jade.tintDan}",    "accentStrong": "{color.jade.700}" },
    "ruza":    { "accent": "{color.ruza.600}",    "accentSoft": "{color.ruza.tintDan}",    "accentStrong": "{color.ruza.700}" },
    "bordo":   { "accent": "{color.bordo.600}",   "accentSoft": "{color.bordo.tintDan}",   "accentStrong": "{color.bordo.700}" },
    "grafit":  { "accent": "{color.grafit.600}",  "accentSoft": "{color.grafit.tintDan}",  "accentStrong": "{color.grafit.700}" }
