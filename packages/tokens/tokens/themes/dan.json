{
  "theme": "dan",
  "semantic": {
    "bg": "{color.paper.100}",
    "surface": "{color.paper.50}",
    "surfaceAlt": "{color.paper.200}",
    "surfaceRaised": "{color.paper.50}",
    "surfaceSunken": "{color.paper.250}",
    "border": "{color.paper.350}",
    "borderStrong": "{color.paper.400}",
