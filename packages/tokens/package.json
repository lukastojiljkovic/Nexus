{
  "name": "@nexus/tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nexus design tokens — Direction D v2 (Dan/Noc). Single source of truth for all styling; raw hex values are forbidden outside this package.",
  "exports": {
    ".": {
      "types": "./dist/ts/index.d.ts",
      "default": "./dist/ts/index.js"
    },
    "./css": "./dist/css/tokens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json",
    "typecheck": "node build.mjs && tsc -p tsconfig.json --noEmit",
    "check": "node build.mjs --check",
    "lint": "eslint ."
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
