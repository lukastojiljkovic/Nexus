{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // `DOM` for the platform globals this package deliberately uses —
    // `TextEncoder`, `TextDecoder`, `URL`, `atob`, `fetch`, `Response`. Same
    // reason as `sync-port`: the sync stack targets the WEB platform surface so
    // that one implementation serves the Electron main process, the renderer
    // and a browser tab. Declared rather than inherited, because until 2026-08-31
    // these names resolved only through an `@types` directory a test runner
    // happened to leave on tsc's type-root walk, and a devDependency bump took
    // them all away at once. Nothing here touches `document` or `window`.
    "lib": ["ES2023", "DOM"],
    // `node` for `live.test.ts` alone, which reads four `process.env` keys, signs
    // a JWT with `node:crypto` and base64url-encodes it with `Buffer`. That test
    // runs against a REAL Supabase project and is skipped everywhere else, but it
    // is compiled with the rest of `src`, so the types it needs are this
    // package's — and `@types/node` is now a declared devDependency rather than
    // something that happened to be reachable.
    "types": ["node"]
  },
  "include": ["src"]
}
