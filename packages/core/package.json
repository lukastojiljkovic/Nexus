{
  "name": "@nexus/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nexus platform-free domain foundation: module registry, feature-module contract types, and feature flags. No React, DOM, or Node APIs.",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth/index.ts",
    "./devtools/*": "./src/devtools/*.ts",
    "./devtools/*.js": "./src/devtools/*.ts",
    "./pro/*": "./src/pro/*.ts",
    "./pro/*.js": "./src/pro/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "yjs": "^13.6.32"
  }
}
