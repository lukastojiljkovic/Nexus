{
  "name": "@nexus/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nexus desktop/Node storage layer: SQLCipher-compatible encrypted SQLite, forward-only migrations, UUIDv7 ids, and the SQLite-backed FlagStore. Electron main-process side only (ADR-001).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@nexus/core": "workspace:*",
    "@nexus/sync": "workspace:*",
    "@nexus/sync-crypto": "workspace:*",
    "@nexus/sync-engine": "workspace:*",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
